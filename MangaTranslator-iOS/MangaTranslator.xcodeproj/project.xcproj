  "targets": [
    {
      "name": "MangaTranslator",
      "id": "235BB3C8309F2698006E7877",
      "product": "Products/MangaTranslator.app",
      "product-type": "application",
      "dependencies": [
        "MangaTranslator Extension",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "copy",
          "name": "Embed Foundation Extensions",
          "bundle-base-path": "plugins-directory",
        },
