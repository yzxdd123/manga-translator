{
  "manifest_version": 2,
  "name": "漫画日译中",
  "version": "2.0",
  "description": "在 Kindle 网页版阅读日文漫画时，自动识别对白并翻译成中文，翻页自动继续。",
  "permissions": ["activeTab", "storage", "nativeMessaging", "https://read.amazon.co.jp/*"],
  "background": {"scripts": ["background.js"], "persistent": false},
  "browser_action": {"default_title": "自动翻译：关（点击开启）"},
  "options_ui": {"page": "options.html", "open_in_tab": true},
  "content_scripts": [{"matches": ["https://read.amazon.co.jp/*"], "js": ["content.js"], "all_frames": true, "run_at": "document_idle"}]
}
